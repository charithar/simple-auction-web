# Cloudflare Pages response headers (copied into dist/ by Vite).
# X-Frame-Options / frame-ancestors: no framing by other sites, so a signed-in
# bidder can't be clickjacked into "Place bid".
#
# Content-Security-Policy-Report-Only is a DRAFT: browsers only log violations
# (DevTools console, "[Report Only]"), nothing is blocked. After signing in,
# bidding and opening the admin page on the deployed site with a clean console,
# merge it into the enforced Content-Security-Policy line below (keeping
# frame-ancestors, which report-only ignores). What it allows:
#   script-src   the bundle; apis.google.com (Firebase Auth popup helper);
#                reCAPTCHA Enterprise for App Check
#   connect-src  Firestore, Auth (identitytoolkit, securetoken), App Check
#   frame-src    the Firebase authDomain (*.firebaseapp.com / *.web.app, so the
#                project id stays out of the repo) and reCAPTCHA
#   img-src      https: because item photos may be hotlinked; Google avatars
#   style-src    'unsafe-inline' for the styles reCAPTCHA injects
# At the same time, add "Cross-Origin-Opener-Policy: same-origin-allow-popups"
# and check sign-in still works (plain same-origin would break the popup).
/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseappcheck.googleapis.com https://content-firebaseappcheck.googleapis.com https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Hashed file names change on every build, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
