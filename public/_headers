# Cloudflare Pages response headers (copied into dist/ by Vite).
# X-Frame-Options / frame-ancestors: no framing by other sites, so a signed-in
# bidder can't be clickjacked into "Place bid".
/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Hashed file names change on every build, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
