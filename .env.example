# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional App Check (reCAPTCHA v3 site key). Leave empty to disable.
VITE_APPCHECK_SITE_KEY=
# Optional, local dev only: App Check debug token registered in the Firebase console.
VITE_APPCHECK_DEBUG_TOKEN=

# Set to "true" to point the app at the local emulators (npm run emulators).
VITE_USE_EMULATORS=false
